# Fase 0
UPLOAD_SECRET=          # any long random string; also set it in Vercel → Settings → Environment Variables

# Ya usadas por el deploy actual
BLOB_READ_WRITE_TOKEN=  # auto-provisioned by Vercel Blob

# Imágenes de posts vía n8n (docs/automation/n8n-post-images.md)
N8N_IMAGES_WEBHOOK_URL=     # webhook del n8n de TU máquina (mac-dev u Hetzner)
N8N_IMAGES_WEBHOOK_SECRET=  # X-Webhook-Secret de esa instancia

# Fase 3 (aún no requeridas)
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
